# ---------- Database (MongoDB Atlas) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=photo_gallery

# ---------- Auth ----------
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# ---------- App ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
MAX_UPLOAD_MB=50
QUOTA_GB=5
AUTH_RATE_LIMIT_PER_MIN=10

# ---------- Storage: local | cloudinary | s3 ----------
STORAGE_PROVIDER=local

# Cloudinary (https://console.cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 or Cloudflare R2 (S3-compatible)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 only: https://<account-id>.r2.cloudflarestorage.com   (leave empty for AWS)
S3_ENDPOINT_URL=
# Optional CloudFront / R2 public domain, e.g. https://dxxxx.cloudfront.net  (empty = presigned URLs)
S3_PUBLIC_BASE_URL=
